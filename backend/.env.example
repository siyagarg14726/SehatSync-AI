# Aarogya360 AI Backend Configuration

# Application
PROJECT_NAME="Aarogya360 AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL Async via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aarogya360
# For local SQLite testing without postgres, use:
# DATABASE_URL=sqlite+aiosqlite:///./aarogya360.db

# Security & JWT
SECRET_KEY=aarogya360_super_secret_jwt_encryption_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS Configuration (comma-separated list of origins, or * for all)
BACKEND_CORS_ORIGINS=["*"]
